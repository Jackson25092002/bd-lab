generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ReceptionStatus {
  pending
  reviewing
  draft
}

enum ExtractionSource {
  manual
  demo
}

model ReceptionRecord {
  id            String @id @default(uuid()) @db.Uuid
  serial        Int @unique @default(autoincrement())
  status        ReceptionStatus @default(pending)
  version       Int @default(0)
  isDemo        Boolean @default(false)
  customer      String @default("") @db.VarChar(300)
  address       String @default("") @db.VarChar(1000)
  contact       String @default("") @db.VarChar(300)
  collectedAt   String @default("") @db.VarChar(10)
  collector     String @default("") @db.VarChar(300)
  note          String @default("") @db.VarChar(5000)
  receivedAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  savedAt       DateTime? @db.Timestamptz(3)
  attachment    PdfAttachment?
  extraction    ExtractionSnapshot?
  samples       Sample[]
  revisions     DraftRevision[]
  @@index([receivedAt])
  @@index([status, receivedAt])
}

model PdfAttachment {
  id           String @id @default(uuid()) @db.Uuid
  recordId     String @unique @db.Uuid
  record       ReceptionRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  originalName String @db.VarChar(250)
  storageKey   String @unique @db.VarChar(100)
  byteSize     Int
  sha256       String @db.Char(64)
  mediaType    String @default("application/pdf") @db.VarChar(50)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model ExtractionSnapshot {
  id        String @id @default(uuid()) @db.Uuid
  recordId  String @unique @db.Uuid
  record    ReceptionRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  source    ExtractionSource
  payload   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Sample {
  id        String @id @default(uuid()) @db.Uuid
  recordId  String @db.Uuid
  record    ReceptionRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  position  Int
  name      String @default("") @db.VarChar(300)
  matrix    String @default("") @db.VarChar(100)
  location  String @default("") @db.VarChar(1000)
  quantity  String @default("") @db.VarChar(200)
  tests     String @default("") @db.VarChar(2000)
  uncertain Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([recordId, position])
  @@index([matrix])
}

model DraftRevision {
  id        String @id @default(uuid()) @db.Uuid
  recordId  String @db.Uuid
  record    ReceptionRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  version   Int
  action    String @db.VarChar(30)
  snapshot  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([recordId, version])
}
